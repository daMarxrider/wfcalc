{
  "name": "wfcalc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline Warframe damage calculator: build weapons, mods, rivens and check damage against real enemies.",
  "license": "GPL-3.0-only",
  "bin": {
    "wfcalc": "./src/cli.ts"
  },
  "engines": {
    "node": ">=23"
  },
  "scripts": {
    "update": "node tools/fetch.ts && node tools/fetch-abilities.ts && node tools/fetch-damage-abilities.ts && node tools/fetch-incarnon.ts && node tools/build-data.ts && node tools/public-export.ts && node tools/fetch-compression.ts && node tools/fetch-snipers.ts",
    "compression": "node tools/fetch-compression.ts",
    "snipers": "node tools/fetch-snipers.ts",
    "public-export": "node tools/public-export.ts",
    "public-export:check": "node tools/public-export.ts --check",
    "serve": "node src/server.ts",
    "calc": "node src/cli.ts",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "eval": "node tools/agent-eval.ts",
    "coverage": "node tools/coverage.ts",
    "validate": "node tools/validate.ts",
    "calibrate": "node tools/calibrate.ts",
    "calibrate:refresh": "node tools/calibrate.ts --refresh",
    "oracle-db": "node tools/fetch-oracle-db.ts",
    "sync": "node tools/sync.ts",
    "sync-check": "node tools/sync.ts --check",
    "drift": "node tools/drift.ts",
    "audit": "node tools/audit.ts",
    "serve:lan": "node src/server.ts --host 0.0.0.0",
    "shot": "node tools/shot.ts",
    "oracle": "node tools/oracle.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  }
}
